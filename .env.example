# Copy to .env (git-ignored) or export in your shell.
# Create an app at https://developer.x.com/en/portal/dashboard,
# enable "User authentication settings" -> OAuth 2.0, and register the
# redirect URI below EXACTLY.

X_CLIENT_ID=your_client_id
# Only for "Web App / Confidential client". Leave empty for "Native App / Public client".
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8080/callback
# Space separated. offline.access is required to get a refresh token.
X_SCOPES=tweet.read users.read offline.access
