{# One lesson day. Expects `d` (parsed day dict). #}
<section class="day" id="day{{ d.day }}">
  <div class="day-head">
    <div class="day-num"><span class="lbl">DAY</span><span class="num">{{ '%02d' % d.day }}</span></div>
    <div class="day-title">
      <h1>{{ d.title_cn }}{% if d.review %}<span class="review-badge">复习日</span>{% endif %}</h1>
      <div class="en-t">{{ d.title_en }}</div>
      <div class="meta">
        <span>📅 Week {{ d.week }} · {{ d.week_name }}</span>
        <span>🎬 场景：{{ d.scene }}</span>
        <span>📚 新词 {{ d.word_count }} 个</span>
      </div>
    </div>
  </div>

  <div class="overview">
    <div class="goals">
      <div class="t">🎯 今天学完，你能……</div>
      <ul>{% for g in d.goals %}<li>{{ g | md }}</li>{% endfor %}</ul>
    </div>
    <table class="plan">
      {% for name, mins in plan %}<tr><td>{{ name }}</td><td class="m">{{ mins }} 分钟</td></tr>{% endfor %}
      <tr class="total"><td>合计</td><td class="m">{{ plan | sum(attribute=1) }} 分钟</td></tr>
    </table>
  </div>

  {# 1. Warm-up #}
  <h2 class="sec"><span class="n">1</span>热身复习 <span class="en-sub">Warm-up</span><span class="mins">{{ plan[0][1] }} 分钟</span></h2>
  <p class="muted">{{ d.warmup_hint | md }}</p>
  <div class="warm">
    {% for w in d.warmup %}<div><span class="num">{{ loop.index }}</span>{{ w.cn | md }}</div>{% endfor %}
  </div>

  {# 2. Story #}
  <h2 class="sec"><span class="n">2</span>今日短剧 · 精读 + 词汇 <span class="en-sub">Story &amp; Words</span><span class="mins">{{ plan[1][1] }} 分钟</span></h2>
  <div class="story-head">
    <div class="ep">{{ d.story_title }}</div>
    <div class="intro">{{ d.story_intro | md }}</div>
  </div>
  <p class="muted" style="font-size:8.6pt">读法：先只看英文，猜意思 → 再看中文核对 → 看词表的「使用场景」 → 最后把整段英文大声读 2 遍。绿色加粗的词就是今天的新词。{% if d.review %}<span class="rcy">橙色虚线</span>标出的是前几天学过的词——先别看词表，试着回忆它的意思和用法。{% endif %}</p>
  {% for p in d.paras %}
  <div class="para">
    <div class="en"><span class="pnum">{{ loop.index }}</span>{{ p.en | md }}</div>
    <div class="cn">{{ p.cn | md }}</div>
    {% if p.words %}
    <table class="vocab">
      <thead><tr><th>单词 / 短语</th><th>美式发音</th><th>中文意思</th><th>使用场景 · 怎么用</th></tr></thead>
      <tbody>
      {% for w in p.words %}
        <tr>
          <td class="w"><b>{{ w.word }}</b>{% if w.pos %}<span class="pos">{{ w.pos }}</span>{% endif %}</td>
          <td class="p"><span class="ipa">/{{ w.ipa }}/</span></td>
          <td class="c">{{ w.meaning | md }}</td>
          <td class="s">{{ w.scene | md }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>
  {% endfor %}

  {% if d.culture %}
  <div class="box culture">
    <div class="bt">🌏 中美文化小贴士：{{ d.culture_title }}</div>
    {% for c in d.culture %}<p>{{ c | md }}</p>{% endfor %}
  </div>
  {% endif %}

  {# 3. Chinese thinking #}
  <h2 class="sec"><span class="n">3</span>中文思维 → 英文表达 <span class="en-sub">Think in Chinese, Speak in English</span><span class="mins">{{ plan[2][1] }} 分钟</span></h2>
  <h3>{{ d.think_title | md }}</h3>
  {% for t in d.think_intro %}<p class="think-intro">{{ t | md }}</p>{% endfor %}
  <table class="pairs">
    <thead><tr><th>中文这么说</th><th>✗ 中式直译</th><th>✓ 英文这么说</th><th>为什么</th></tr></thead>
    <tbody>
    {% for p in d.pairs %}
      <tr>
        <td class="zh">{{ p.zh | md }}</td>
        <td class="bad">{% if p.bad and p.bad != '-' %}<span class="wrong">{{ p.bad | md }}</span>{% else %}<span class="muted">—</span>{% endif %}</td>
        <td class="good">{{ p.good | md }}</td>
        <td class="note">{{ p.note | md }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if d.think_tip %}
  <div class="box tip"><div class="bt">💡 一句话记住</div>{{ d.think_tip | md }}</div>
  {% endif %}

  {# 4. Dialogue #}
  <h2 class="sec"><span class="n">4</span>场景对话 + 发音 <span class="en-sub">Dialogue &amp; Pronunciation</span><span class="mins">{{ plan[3][1] }} 分钟</span></h2>
  <h3>{{ d.dlg_title }}</h3>
  {% if d.dlg_intro %}<p class="dlg-intro">{{ d.dlg_intro | md }}</p>{% endif %}
  <table class="dlg">
    {% for l in d.lines %}
    <tr><td class="who">{{ l.who }}</td><td class="line">{{ l.en | md }}</td><td class="zh">{{ l.zh | md }}</td></tr>
    {% endfor %}
  </table>
  <p class="legend">标注说明：<b>加粗下划线</b> = 句子重音（读得重一点、长一点）；<span class="lk">‿</span> = 连读（两个词连成一个音读）。</p>

  {% if d.pron_title %}
  <div class="box pron">
    <div class="bt">🔊 发音小课：{{ d.pron_title | md }}</div>
    <ul>{% for p in d.pron %}<li>{{ p | md }}</li>{% endfor %}</ul>
    {% if d.pron_drill %}<div class="drill">{{ d.pron_drill | md }}</div>{% endif %}
  </div>
  {% endif %}

  <h3>拿来就用的句块 · Useful Chunks</h3>
  <table class="chunks">
    {% for c in d.chunks %}
    <tr><td class="e">{{ c.en | md }}</td><td class="z">{{ c.zh | md }}</td><td class="u">{{ c.use | md }}</td></tr>
    {% endfor %}
  </table>

  {# 5. Speaking #}
  <h2 class="sec"><span class="n">5</span>口语练习 <span class="en-sub">Speaking Practice</span><span class="mins">{{ plan[4][1] }} 分钟</span></h2>
  <div class="ex">
    <div class="et"><span class="k">A</span>跟读模仿 Shadowing</div>
    <div class="hint">{{ d.shadow | md }}</div>
  </div>
  <div class="ex">
    <div class="et"><span class="k">B</span>中译英 · 张口说（先说出来，再看答案）</div>
    <ol class="items">{% for s in d.say %}<li>{{ s.zh | md }}</li>{% endfor %}</ol>
  </div>
  <div class="ex">
    <div class="et"><span class="k">C</span>情景应答 · 别人这么说，你怎么回？</div>
    <ol class="items">{% for r in d.respond %}<li>{{ r.q | md }}</li>{% endfor %}</ol>
  </div>
  <div class="ex">
    <div class="et"><span class="k">D</span>1 分钟开口说：{{ d.talk_topic | md }}</div>
    <div class="hint">用下面的句子框架，录一段 1 分钟的音频。不求完美，求说完。</div>
    <div class="frame">{% for f in d.talk_frame %}<div>{{ f | md }}</div>{% endfor %}</div>
  </div>

  {# 6. Vocabulary #}
  <h2 class="sec"><span class="n">6</span>词汇理解 <span class="en-sub">Words in Context</span><span class="mins">{{ plan[5][1] }} 分钟</span></h2>
  <div class="ex">
    <div class="et"><span class="k">A</span>语境填空：根据意思选词，必要时变形</div>
    <div class="bank">{% for b in d.fill_bank %}<span>{{ b }}</span>{% endfor %}</div>
    <ol class="items">{% for f in d.fill %}<li><span class="q-en">{{ f.q | md }}</span>{% if f.zh %} <span class="muted">（{{ f.zh | md }}）</span>{% endif %}</li>{% endfor %}</ol>
  </div>
  <div class="ex">
    <div class="et"><span class="k">B</span>场景判断：哪个说法最合适？</div>
    <ol class="items">
      {% for c in d.choose %}
      <li>{{ c.q | md }}
        <div class="opts">{% for o in c.opts %}<span>{{ 'ABCD'[loop.index0] }}. {{ o | md }}</span>{% endfor %}</div>
      </li>
      {% endfor %}
    </ol>
  </div>
  <div class="ex">
    <div class="et"><span class="k">C</span>中式英语找茬：把句子改地道</div>
    <ol class="items">{% for f in d.fix %}<li><span class="q-en">{{ f.wrong | md }}</span><span class="blank-line"></span></li>{% endfor %}</ol>
  </div>

  {% if d.assess %}
  <h2 class="sec"><span class="n">✓</span>第一阶段自评 <span class="en-sub">Self-Assessment</span></h2>
  <p class="muted">做完上面的测试后，诚实地给自己打勾。没有人会看，这张表只为你自己服务。</p>
  <table class="assess">
    <thead><tr><th>我能……</th><th>能做到</th><th>基本能</th><th>还不行</th><th>对应 Day</th></tr></thead>
    <tbody>
    {% for a in d.assess %}{% set parts = a.split(' | ') %}
      <tr><td>{{ parts[0] | md }}</td><td class="cb">☐</td><td class="cb">☐</td><td class="cb">☐</td><td class="dd">{{ parts[1] if parts|length > 1 else '' }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% if d.next_steps %}
  <div class="box tip"><div class="bt">🧭 下一步怎么走</div><ul class="dots">{% for n in d.next_steps %}<li>{{ n | md }}</li>{% endfor %}</ul></div>
  {% endif %}
  {% endif %}

  {# Answers #}
  <div class="answers">
    <div class="at">📖 Day {{ d.day }} 参考答案</div>
    <div class="ag"><span class="gl">热身：</span>{% for w in d.warmup %}{{ loop.index }}. <span class="en">{{ w.en | md }}</span>{% if not loop.last %}　{% endif %}{% endfor %}</div>
    <div class="ag"><span class="gl">口语 B：</span>{% for s in d.say %}{{ loop.index }}. <span class="en">{{ s.en | md }}</span>{% if not loop.last %}　{% endif %}{% endfor %}</div>
    <div class="ag"><span class="gl">口语 C（参考说法，意思对即可）：</span>{% for r in d.respond %}{{ loop.index }}. <span class="en">{{ r.a | md }}</span>{% if not loop.last %}　{% endif %}{% endfor %}</div>
    <div class="ag"><span class="gl">口语 D 范例：</span><span class="en">{{ d.talk_sample | md }}</span></div>
    <div class="ag"><span class="gl">词汇 A：</span>{% for f in d.fill %}{{ loop.index }}. <span class="en">{{ f.a | md }}</span>{% if not loop.last %}　{% endif %}{% endfor %}</div>
    <div class="ag"><span class="gl">词汇 B：</span>{% for c in d.choose %}{{ loop.index }}. <b>{{ c.a }}</b> {{ c.why | md }}{% if not loop.last %}　{% endif %}{% endfor %}</div>
    <div class="ag"><span class="gl">词汇 C：</span>{% for f in d.fix %}{{ loop.index }}. <span class="en">{{ f.right | md }}</span> <span class="muted">{{ f.why | md }}</span>{% if not loop.last %}　{% endif %}{% endfor %}</div>
  </div>

  <div class="checkin">
    <div class="t">✅ Day {{ d.day }} 打卡</div>
    <div class="row">
      <span>短剧大声读了 2 遍</span><span>词表「使用场景」都看了</span><span>对话跟读 3 遍并录音</span><span>口语 B/C/D 都开口说了</span><span>词汇题做完并订正</span>
    </div>
    <div class="row" style="margin-top:1mm"><span class="muted" style="font-size:8.5pt">今天我最想记住的一句话：</span></div>
    <div class="note-line"></div>
  </div>
</section>
