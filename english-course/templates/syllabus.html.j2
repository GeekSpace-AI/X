<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>{{ s.title }} · 课程总纲</title>
<link rel="stylesheet" href="style.css">
<style>@page { @bottom-left { content: "{{ footer }}"; } }</style>
</head>
<body>

<div class="cover">
  <div class="tag">BUSINESS ENGLISH · 90 DAYS</div>
  <h1>{{ s.title }}</h1>
  <div class="sub">{{ s.subtitle }}</div>
  <div class="en-title">{{ s.title_en }}</div>
  <div class="bar"></div>
  <ul>{% for b in s.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  <div class="big-num">90</div>
  <div class="foot">课程总纲 · 学习方法 · 路线图 · 音标速查 · 资源推荐 · 打卡表</div>
</div>

<section>
  <h1 class="chapter">写给你的话<span class="en-sub">A Letter from Your Teacher</span></h1>
  <div class="lead">
    {% for p in s.letter %}<p>{{ p | md }}</p>{% endfor %}
    <p class="sign">{{ s.letter_sign }}</p>
  </div>
</section>

<section class="pagebreak">
  <h1 class="chapter">这套课程的 6 个原则<span class="en-sub">How This Course Works</span></h1>
  <div class="cards" style="grid-template-columns: 1fr 1fr;">
    {% for p in s.principles %}
    <div class="card"><div class="ct">{{ loop.index }}. {{ p[0] }}</div><div style="margin-top:1mm">{{ p[1] | md }}</div></div>
    {% endfor %}
  </div>

  <h2 class="sec"><span class="n">⏱</span>每天 2 小时，固定 6 步</h2>
  <table class="grid">
    <tr><th>环节</th><th>时间</th><th>具体怎么做</th></tr>
    {% for r in s.routine %}<tr><td class="c">{{ r[0] }}</td><td class="c">{{ r[1] }}</td><td>{{ r[2] | md }}</td></tr>{% endfor %}
  </table>
  <div class="box tip"><div class="bt">💡 上班族怎么安排</div>{{ s.split_tip | md }}</div>

  <h2 class="sec"><span class="n">✓</span>开始之前，先做 4 件事</h2>
  <ul class="dots">{% for b in s.before_start %}<li>{{ b | md }}</li>{% endfor %}</ul>
</section>

<section class="pagebreak">
  <h1 class="chapter">90 天路线图<span class="en-sub">The Roadmap</span></h1>
  <p class="lead">整套课程分三个阶段，每个阶段 30 天、约 4 周。每周 6 天学新内容，第 7 天是复习日；每个阶段最后两天是总复习和阶段测试。一部职场连续剧贯穿始终：主角 Lily 从新人一路成长为销售主管。</p>
  <div class="cards">
    {% for ph in s.phases %}
    <div class="card">
      <div class="ct">{{ ph.name }}</div>
      <div class="cs">{{ ph.days }} · {{ ph.words }}</div>
      <div style="font-weight:700; margin-bottom:1mm">{{ ph.theme }}</div>
      <div class="muted" style="font-size:8.6pt; margin-bottom:1.5mm">{{ ph.story }}</div>
      <ul>{% for g in ph.goals %}<li>{{ g | md }}</li>{% endfor %}</ul>
    </div>
    {% endfor %}
  </div>
  <div class="box culture">
    <div class="bt">📊 90 天学完，你会有什么？</div>
    <p>约 <b>3,000 个</b>词汇卡（每个都有美式音标、中文意思、使用场景）＋ 约 <b>720 个</b>拿来就用的句块；第一阶段的短剧和对话里就出现了 <b>{{ distinct_words }}</b> 个不同的英文词形——这还不算你本来就认识的词。</p>
    <p>约 <b>80 个</b>「中文思维 → 英文表达」对照点；<b>90 段</b>你自己的 1 分钟英文录音，记录你从开不了口到流利表达的全过程。</p>
  </div>
</section>

<section class="pagebreak">
  <h1 class="chapter">每日课程表<span class="en-sub">Day by Day</span></h1>
  <p class="muted">「中文思维点」是当天重点攻克的中文习惯。第一阶段已完成，第二、三阶段为规划大纲，会按同样的格式陆续编写。</p>
  <table class="grid">
    <tr><th style="width:12mm">Day</th><th>主题</th><th>English</th><th>中文思维点</th></tr>
    <tr class="wk"><td colspan="4">第一阶段 · 开口期（Day 1–30）</td></tr>
    {% set ns = namespace(wk=0) %}
    {% for d in p1days %}
      {% if d.week != ns.wk %}{% set ns.wk = d.week %}<tr class="wk"><td colspan="4" style="font-weight:400">Week {{ d.week }} · {{ d.week_name }}</td></tr>{% endif %}
      <tr{% if d.review %} class="rv"{% endif %}><td class="c">{{ d.day }}</td><td>{{ d.title_cn }}</td><td class="en">{{ d.title_en }}</td><td>{{ d.think_short }}</td></tr>
    {% endfor %}
    {% for title, rows in [("第二阶段 · 流利期（Day 31–60）", s.phase2_days), ("第三阶段 · 进阶期（Day 61–90）", s.phase3_days)] %}
      <tr class="wk"><td colspan="4">{{ title }}</td></tr>
      {% set ns2 = namespace(mod='') %}
      {% for r in rows %}
        {% if r[4] != ns2.mod %}{% set ns2.mod = r[4] %}<tr class="wk"><td colspan="4" style="font-weight:400">模块 {{ r[4] }}</td></tr>{% endif %}
        <tr{% if '复习' in r[1] or '测试' in r[1] %} class="rv"{% endif %}><td class="c">{{ r[0] }}</td><td>{{ r[1] }}</td><td class="en">{{ r[2] }}</td><td>{{ r[3] }}</td></tr>
      {% endfor %}
    {% endfor %}
  </table>
</section>

<section class="pagebreak">
  <h1 class="chapter">中文思维 vs. 英文思维<span class="en-sub">10 Big Differences</span></h1>
  <p class="lead">这 10 条，是中国人说英语时最常见的「中文习惯」。整套课程的「中文思维 → 英文表达」小节，都是围绕它们展开的。先有个整体印象，学到对应的那一天时再细细体会。</p>
  <table class="grid">
    <tr><th style="width:8mm">#</th><th style="width:30%">差异</th><th>例子</th><th style="width:14%">详见</th></tr>
    {% for d in s.differences %}<tr><td class="c">{{ loop.index }}</td><td><b>{{ d[0] }}</b></td><td>{{ d[1] | md }}</td><td class="c" style="font-weight:400">{{ d[2] }}</td></tr>{% endfor %}
  </table>
</section>

<section class="pagebreak">
  <h1 class="chapter">美式音标速查<span class="en-sub">American English Sounds</span></h1>
  <p class="muted">本书使用的美式音标，与欧路、有道词典中标注「美」的音标一致。中文提示只是帮你找到大概的口型，一定要配合词典发音反复听。</p>
  <h2 class="sec"><span class="n">1</span>单元音</h2>
  <table class="grid">
    <tr><th style="width:14%">音标</th><th style="width:30%">例词</th><th>怎么发</th></tr>
    {% for v in s.ipa_vowels %}<tr><td class="c"><span class="ipa">/{{ v[0] }}/</span></td><td class="en">{{ v[1] }}</td><td>{{ v[2] | md }}</td></tr>{% endfor %}
  </table>
  <h2 class="sec"><span class="n">2</span>双元音</h2>
  <table class="grid">
    <tr><th style="width:14%">音标</th><th style="width:30%">例词</th><th>怎么发</th></tr>
    {% for v in s.ipa_diph %}<tr><td class="c"><span class="ipa">/{{ v[0] }}/</span></td><td class="en">{{ v[1] }}</td><td>{{ v[2] | md }}</td></tr>{% endfor %}
  </table>
  <h2 class="sec"><span class="n">3</span>中国人最容易读错的辅音</h2>
  <table class="grid">
    <tr><th style="width:14%">音标</th><th style="width:30%">例词</th><th>怎么发</th></tr>
    {% for v in s.ipa_cons %}<tr><td class="c"><span class="ipa">/{{ v[0] }}/</span></td><td class="en">{{ v[1] }}</td><td>{{ v[2] | md }}</td></tr>{% endfor %}
  </table>
  <h2 class="sec"><span class="n">4</span>符号说明</h2>
  <ul class="dots">{% for m in s.ipa_marks %}<li>{{ m | md }}</li>{% endfor %}</ul>
</section>

<section class="pagebreak">
  <h1 class="chapter">学习资源推荐<span class="en-sub">Resources</span></h1>
  {% for g in s.resources %}
  <h2 class="sec"><span class="n">{{ loop.index }}</span>{{ g.group }}</h2>
  <table class="grid">
    <tr><th style="width:26%">名称</th><th>是什么</th><th style="width:32%">怎么配合本课程用</th></tr>
    {% for it in g.entries %}<tr><td><b class="en">{{ it[0] }}</b></td><td>{{ it[1] | md }}</td><td>{{ it[2] | md }}</td></tr>{% endfor %}
  </table>
  {% endfor %}
  <div class="box tip"><div class="bt">⚠️ 提醒</div>{{ s.resource_note | md }}</div>
</section>

<section class="pagebreak">
  <h1 class="chapter">90 天打卡表<span class="en-sub">Progress Tracker</span></h1>
  <p class="muted">{{ s.tracker_note }}</p>
  {% for ph in [(1, 30, '第一阶段 · 开口期'), (31, 60, '第二阶段 · 流利期'), (61, 90, '第三阶段 · 进阶期')] %}
  <h2 class="sec"><span class="n">{{ loop.index }}</span>{{ ph[2] }}</h2>
  <table class="tracker">
    {% for row in range(ph[0], ph[1] + 1, 10) %}
    <tr>{% for d in range(row, row + 10) %}<td><div class="dd">D{{ d }}</div><div style="font-family:'DejaVu Sans'; font-size:11pt; color:#1f3a5f">☐</div><div style="border-bottom:0.5pt solid #c4ccd8; height:4mm"></div></td>{% endfor %}</tr>
    {% endfor %}
  </table>
  {% endfor %}
  <div class="checkin" style="margin-top:5mm">
    <div class="t">🎙 我的录音里程碑</div>
    <div class="row"><span>Day 0 录音（开始前）</span><span>Day 30 阶段测试录音</span><span>Day 60 阶段测试录音</span><span>Day 90 毕业录音</span></div>
  </div>
</section>

</body>
</html>
